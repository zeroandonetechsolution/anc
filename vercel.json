{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/",                        "destination": "/frontend/index.html" },
    { "source": "/assets/:path*",           "destination": "/assets/:path*" },
    { "source": "/frontend/:path*",         "destination": "/frontend/:path*" },
    { "source": "/:name",                   "destination": "/frontend/pages/:name.html" },
    { "source": "/pages/:name",             "destination": "/frontend/pages/:name.html" },
    { "source": "/pages/:name.html",        "destination": "/frontend/pages/:name.html" },
    { "source": "/:name.html",              "destination": "/frontend/pages/:name.html" },
    { "source": "/:path*",                  "destination": "/frontend/:path*" }
  ],
  "redirects": [
    { "source": "/index.php",               "destination": "/",                   "permanent": true },
    { "source": "/index.html",              "destination": "/",                   "permanent": true },
    { "source": "/frontend/index.html",     "destination": "/",                   "permanent": true },
    { "source": "/frontend/pages/:name.html","destination": "/:name",              "permanent": true },
    { "source": "/backend/(.*)",            "destination": "/",                   "permanent": false },
    { "source": "/config/(.*)",             "destination": "/",                   "permanent": false },
    { "source": "/scripts/(.*)",            "destination": "/",                   "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
